{
  "name": "hopscotch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test:builder-contract": "node scripts/builder-contract-check.mjs",
    "test:worker-contract": "node scripts/worker-contract-check.mjs",
    "test:journey-contract": "node scripts/journey-contract-check.mjs",
    "check": "npm run typecheck && npm run test:builder-contract && npm run test:worker-contract && npm run test:journey-contract && npm run build",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types:worker": "wrangler types"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "^4.120.0"
  }
}