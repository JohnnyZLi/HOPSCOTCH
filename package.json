{
  "name": "hopscotch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types:worker": "wrangler types"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
