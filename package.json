{
  "name": "hopscotch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "pretypecheck": "python3 scripts/apply-lab08b.py && python3 scripts/fix-lab08b-physical-types.py && python3 scripts/apply-lab08b-performance.py",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test:builder-contract": "node scripts/builder-contract-check.mjs",
    "test:worker-contract": "node scripts/worker-contract-check.mjs",
    "test:journey-contract": "node scripts/journey-contract-check.mjs",
    "test:journey-sharing-contract": "node scripts/journey-sharing-contract-check.mjs",
    "check": "npm run typecheck && npm run test:builder-contract && npm run test:worker-contract && npm run test:journey-contract && npm run test:journey-sharing-contract && npm run test:journey-god-mode-contract && npm run test:journey-composition-contract && npm run test:journey-path-outage-contract && npm run test:journey-congestion-contract && npm run test:journey-dns-failure-contract && npm run test:journey-server-failure-contract && npm run test:journey-partition-contract && npm run test:journey-route-leak-contract && npm run test:high-density-contract && npm run build",
    "performance:profile": "node scripts/performance-profile.mjs",
    "performance:check": "node scripts/performance-profile.mjs --enforce",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types:worker": "wrangler types",
    "test:journey-god-mode-contract": "node scripts/journey-god-mode-contract-check.mjs",
    "test:journey-composition-contract": "node scripts/journey-composition-contract-check.mjs",
    "test:journey-path-outage-contract": "node scripts/journey-path-outage-contract-check.mjs",
    "test:journey-congestion-contract": "node scripts/journey-congestion-contract-check.mjs",
    "test:journey-dns-failure-contract": "node scripts/journey-dns-failure-contract-check.mjs",
    "test:journey-server-failure-contract": "node scripts/journey-server-failure-contract-check.mjs",
    "test:journey-partition-contract": "node scripts/journey-partition-contract-check.mjs",
    "test:journey-route-leak-contract": "node scripts/journey-route-leak-contract-check.mjs",
    "test:high-density-contract": "node scripts/high-density-contract-check.mjs"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "^4.120.0"
  }
}
