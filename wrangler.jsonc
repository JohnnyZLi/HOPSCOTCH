{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hopscotch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "hopscotch.johnnyli.dev",
      "custom_domain": true
    }
  ]
}
